---
import '@fontsource-variable/geist';
import '../styles/global.css';
import ThemeToggle from '../components/theme/ThemeToggle';
import { Analytics } from '@vercel/analytics/react';
import { SpeedInsights } from '@vercel/speed-insights/react';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jules O'Dea - Frontend Developer | Auckland, New Zealand",
  description = "Frontend Developer specialising in modern web technologies and user experiences based in New Zealand.",
} = Astro.props;

const links = [
  { label: 'GitHub', href: 'https://github.com/julesodea' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/julesodea' },
  { label: 'CV', href: '/cv' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Frontend Developer, Web Developer, React, Next.js, Auckland, New Zealand, Portfolio" />
    <meta name="author" content="Jules O'Dea" />
    <meta name="creator" content="Jules O'Dea" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:url" content="https://juleso.vercel.app" />
    <meta property="og:title" content="Jules O'Dea - Frontend Developer" />
    <meta property="og:description" content="Frontend Developer specializing in modern web technologies and user experiences. Based in Auckland, New Zealand." />
    <meta property="og:site_name" content="Jules O'Dea Portfolio" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />

    <!-- Google Verification -->
    <meta name="google-site-verification" content="5f316b0ee6e8141e" />

    <link rel="canonical" href="https://juleso.vercel.app" />
    <title>{title}</title>

    <script is:inline>
      // Prevent flash of wrong theme
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.classList.add(theme);
      })();
    </script>
  </head>
  <body>
    <div class="flex min-h-dvh flex-col px-6 py-8 sm:px-10 sm:py-10 lg:px-16">
      <header class="flex items-center justify-between text-sm sm:text-base">
        <a href="/" class="font-bold tracking-tight underline-offset-4 hover:underline">JULES O'DEA</a>
        <ThemeToggle client:load />
      </header>

      <main class="flex flex-1 flex-col justify-center py-24">
        <slot />
      </main>

      <footer class="flex flex-col-reverse gap-8 sm:flex-row sm:items-end sm:justify-between">
        <ul class="flex gap-6 text-xs sm:text-sm">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noreferrer" class="underline-offset-4 hover:underline">{label}</a>
            </li>
          ))}
        </ul>
        <a
          href="mailto:jules.odea@gmail.com"
          class="text-lg tracking-tight underline-offset-4 hover:underline sm:text-[1.40625rem] lg:text-[1.6875rem]"
        >
          jules.odea@gmail.com
        </a>
      </footer>
    </div>
    <Analytics client:only="react" />
    <SpeedInsights client:only="react" />
  </body>
</html>
