---
const iconClass = "w-5 h-5 shrink-0 text-neutral-700 dark:text-neutral-200";
---

<button
  id="theme-toggle"
  type="button"
  class="w-10 h-10 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center hover:opacity-80 transition-opacity p-0"
  title="Toggle theme"
>
  <svg class={`${iconClass} hidden dark:block`} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2 L6 11 h4 l-2 9 l8-11 h-4 l2-6 l-2-1 z" />
  </svg>
  <svg class={`${iconClass} block dark:hidden`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const button = document.getElementById("theme-toggle")!;
  const root = document.documentElement;

  const setTitle = () => {
    button.title = root.classList.contains("dark") ? "Toggle to Light Mode" : "Toggle to Dark Mode";
  };

  setTitle();

  button.addEventListener("click", () => {
    const newTheme = root.classList.contains("dark") ? "light" : "dark";
    root.classList.remove("light", "dark");
    root.classList.add(newTheme);
    localStorage.setItem("theme", newTheme);
    setTitle();
  });
</script>
